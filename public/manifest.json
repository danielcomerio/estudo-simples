{
  "id": "estudo-simples-app",
  "name": "Estudo Simples — Concursos Públicos",
  "short_name": "Estudo Simples",
  "description": "Repetição espaçada (SRS) para concursos públicos. SM-2 + FSRS-6, simulado, discursivas, cloze e flashcards. Offline-first.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b1220",
  "theme_color": "#22c55e",
  "dir": "ltr",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "categories": ["education", "productivity", "books"],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Estudar agora",
      "short_name": "Estudar",
      "description": "Sessão SRS automática com 10 questões",
      "url": "/estudar?modo=srs&qtd=10&auto=1",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Cards (Cloze + Flashcard)",
      "short_name": "Cards",
      "description": "Sessão de cards de memorização",
      "url": "/cards",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Banco de questões",
      "short_name": "Banco",
      "description": "Lista, filtros e import",
      "url": "/banco",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Estatísticas",
      "short_name": "Stats",
      "description": "Desempenho e métricas",
      "url": "/stats",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 480
  }
}
